// category.jsonc — 商品分类 — 树形表示例（parent_id 自引用 + path/level 冗余）
// 规范依据：SKILL.md §15.1
{
  "title": "category",
  "description": "商品分类 — 树形表示例（parent_id 自引用 + path/level 冗余）",
  "type": "object",
  "$base": ["base"],
  "properties": {
    "id": {
      "type": "bigserial",
      "required": true,
      "primary": true,
      "description": "主键",
      "order": 1
    },
    "parent_id": {
      "type": "bigint",
      "required": false,
      "primary": false,
      "ref": {
        "entity": "{self}",
        "property": "id"
      },
      "description": "父级ID，NULL 为根节点",
      "order": 10
    },
    "name": {
      "type": "character varying(50)",
      "required": true,
      "primary": false,
      "description": "分类名称",
      "order": 20
    },
    "path": {
      "type": "character varying(500)",
      "required": false,
      "default": "",
      "primary": false,
      "description": "ID 路径如 /1/3/7，供 LIKE 前缀查询子树",
      "order": 30
    },
    "level": {
      "type": "smallint",
      "required": false,
      "default": "0",
      "primary": false,
      "description": "层级深度，根 = 0",
      "order": 40
    },
    "sort": {
      "type": "integer",
      "required": false,
      "default": "0",
      "primary": false,
      "description": "同级排序号",
      "order": 50
    }
  },
  "required": ["id", "name"]
}

// ── 设计要点 ──
// 树形表三件套必须同时维护：`parent_id` 建关系、`path` 支撑子树查询、`level` 限制最大深度。
// 只写 `parent_id` 的话，查子树要走递归 CTE，深度一大性能就塌；`path LIKE '/1/%'` 一次扫完。
// `ref.entity` 为 `{self}` 表示自引用。
